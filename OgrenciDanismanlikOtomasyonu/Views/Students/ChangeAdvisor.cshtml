@model BusinessLogicLayer.clsStudentBusiness
@{
    ViewData["Title"] = "Danışman Değiştir";
    var history       = ViewBag.AdvisorHistory as List<EntityLayer.clsAdvisorAssignmentHistory>
                        ?? new List<EntityLayer.clsAdvisorAssignmentHistory>();
    var advisors      = ViewBag.ActiveAdvisors as List<EntityLayer.clsAdvisorInfo>
                        ?? new List<EntityLayer.clsAdvisorInfo>();
}

@await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData) {
    ["HeaderTitle"]    = "Danışman Değiştir",
    ["HeaderSubtitle"] = $"{Model.GetFullName()} · Danışman ataması"
})

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger d-flex align-items-start gap-2 mb-3" style="max-width:560px">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1"></i>
        <div>
            @foreach (var fieldState in ViewData.ModelState.Values)
            {
                @foreach (var fieldError in fieldState.Errors)
                {
                    <div>@fieldError.ErrorMessage</div>
                }
            }
        </div>
    </div>
}

<form method="post" asp-action="ChangeAdvisor">
    @Html.AntiForgeryToken()
    <input type="hidden" name="studentId" value="@Model.StudentId" />
    <div class="form-card mb-4" style="max-width:560px">
        <div class="form-card-body">
            <div class="mb-3">
                <label class="form-label required">Yeni Danışman</label>
                <select name="newAdvisorId" class="form-select" required>
                    <option value="0">-- Danışman Seçiniz --</option>
                    @foreach (var advisor in advisors)
                    {
                        <option value="@advisor.AdvisorId">@advisor.FullName</option>
                    }
                </select>
                @if (!advisors.Any())
                {
                    <div class="form-text text-warning">
                        Bu bölümde atanabilecek aktif danışman bulunmamaktadır.
                    </div>
                }
            </div>
            <div class="mb-0">
                <label class="form-label">Değişiklik Nedeni</label>
                <input type="text" name="changeReason" class="form-control" maxlength="500"
                       placeholder="İsteğe bağlı…" />
            </div>
        </div>
        <div class="form-card-footer">
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
            <button type="submit" class="btn btn-primary" @(!advisors.Any() ? "disabled" : "")>
                <i class="bi bi-check2 me-1"></i>Ata
            </button>
        </div>
    </div>
</form>

<h2 class="section-title mb-3">Danışman Geçmişi</h2>
@if (!history.Any())
{
    @await Html.PartialAsync("_EmptyState", new ViewDataDictionary(ViewData) {
        ["EmptyIcon"]    = "bi-clock-history",
        ["EmptyMessage"] = "Henüz danışman ataması yapılmamış."
    })
}
else
{
    <div class="card-table" style="max-width:720px">
        <table class="table data-table mb-0">
            <thead>
                <tr>
                    <th>Danışman</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>
                    <th>Neden</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var assignment in history)
                {
                    <tr>
                        <td>@assignment.AdvisorFullName</td>
                        <td>@assignment.StartDate.ToString("dd.MM.yyyy")</td>
                        <td>@(assignment.EndDate.HasValue ? assignment.EndDate.Value.ToString("dd.MM.yyyy") : "—")</td>
                        <td>@(string.IsNullOrWhiteSpace(assignment.ChangeReason) ? "—" : assignment.ChangeReason)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
