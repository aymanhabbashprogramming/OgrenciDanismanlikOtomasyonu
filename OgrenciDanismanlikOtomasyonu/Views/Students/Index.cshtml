@model List<EntityLayer.clsStudentInfo>
@{
    ViewData["Title"]   = "Öğrenciler";
    string? activeFilter = ViewBag.ActiveFilter as string;
}

@await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData) {
    ["HeaderTitle"]      = "Öğrenciler",
    ["HeaderSubtitle"]   = "Bölüme kayıtlı öğrenci listesi",
    ["HeaderActionText"] = "Yeni Öğrenci",
    ["HeaderActionLink"] = Url.Action("Edit", "Students")
})

@if (activeFilter == "noAdvisor")
{
    <div class="alert alert-info d-flex align-items-center justify-content-between gap-2 mb-3">
        <span><i class="bi bi-funnel-fill me-2"></i>Filtre: Aktif danışmanı olmayan öğrenciler</span>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Filtreyi Kaldır</a>
    </div>
}
else if (activeFilter == "inactiveAdvisor")
{
    <div class="alert alert-info d-flex align-items-center justify-content-between gap-2 mb-3">
        <span><i class="bi bi-funnel-fill me-2"></i>Filtre: Pasif danışmanlı öğrenciler</span>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Filtreyi Kaldır</a>
    </div>
}
else if (ViewBag.FilterAdvisorId != null)
{
    <div class="alert alert-info d-flex align-items-center justify-content-between gap-2 mb-3">
        <span><i class="bi bi-funnel-fill me-2"></i>Filtre: @(ViewBag.FilterAdvisorName ?? "Seçili danışman") öğrencileri</span>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Filtreyi Kaldır</a>
    </div>
}

@if (TempData["Success"] is string successMsg)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
        <span>@successMsg</span>
    </div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
        <span>@errorMsg</span>
    </div>
}

@await Html.PartialAsync("_SearchBox", new ViewDataDictionary(ViewData) {
    ["SearchTableId"]     = "studentsTable",
    ["SearchPlaceholder"] = "Ad, soyad veya öğrenci nosu ile ara…",
    ["SearchCountLabel"]  = "öğrenci"
})

@if (!Model.Any())
{
    @await Html.PartialAsync("_EmptyState", new ViewDataDictionary(ViewData) {
        ["EmptyIcon"]       = "bi-mortarboard",
        ["EmptyMessage"]    = "Kayıtlı öğrenci bulunamadı.",
        ["EmptyActionText"] = "Öğrenci Ekle",
        ["EmptyActionLink"] = Url.Action("Edit", "Students")
    })
}
else
{
    <div class="card-table">
        <table class="table data-table mb-0" id="studentsTable">
            <thead>
                <tr>
                    <th>Öğrenci No</th>
                    <th>Ad Soyad</th>
                    <th>Bölüm</th>
                    <th>Danışman</th>
                    <th>Kullanıcı Adı</th>
                    <th>Durum</th>
                    <th style="width:160px">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-id" data-label="Öğrenci No">@item.StudentNumber</td>
                        <td data-label="Ad Soyad">@item.FullName</td>
                        <td data-label="Bölüm">@item.DepartmentName</td>
                        <td data-label="Danışman">
                            @if (item.AdvisorFullName != null)
                            {
                                @item.AdvisorFullName
                                @if (item.IsAdvisorActive == false)
                                {
                                    <span class="badge-inactive ms-1">Pasif</span>
                                }
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td data-label="Kullanıcı Adı">@item.Username</td>
                        <td data-label="Durum">
                            @if (item.IsActive)
                            {
                                <span class="status-accepted">Aktif</span>
                            }
                            else
                            {
                                <span class="status-sent">Pasif</span>
                            }
                        </td>
                        <td data-label="İşlemler" class="cell-actions">
                            <div class="d-flex gap-1 align-items-center">
                                <a asp-action="Edit" asp-route-id="@item.StudentId"
                                   class="btn-icon btn-icon-primary"
                                   data-bs-toggle="tooltip" title="Düzenle">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="ChangeAdvisor" asp-route-id="@item.StudentId"
                                   class="btn-icon btn-icon-primary"
                                   data-bs-toggle="tooltip" title="Danışman Ata / Değiştir">
                                    <i class="bi bi-person-badge"></i>
                                </a>
                                <a asp-action="ResetPassword" asp-route-id="@item.StudentId"
                                   class="btn-icon btn-icon-primary"
                                   data-bs-toggle="tooltip" title="Şifre Sıfırla">
                                    <i class="bi bi-key"></i>
                                </a>
                                <form method="post" asp-action="ToggleActive" class="d-inline">
                                    <input type="hidden" name="id" value="@item.StudentId" />
                                    @if (item.IsActive)
                                    {
                                        <button type="submit" class="btn-icon btn-icon-warning"
                                                data-bs-toggle="tooltip" title="Devre Dışı Bırak">
                                            <i class="bi bi-pause-circle"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn-icon btn-icon-success"
                                                data-bs-toggle="tooltip" title="Aktif Et">
                                            <i class="bi bi-play-circle"></i>
                                        </button>
                                    }
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

