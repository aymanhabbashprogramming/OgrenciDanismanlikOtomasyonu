@model BusinessLogicLayer.clsStudentBusiness
@{
    ViewData["Title"] = "Şifre Sıfırla";
}

@await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData) {
    ["PHTitle"]    = "Şifre Sıfırla",
    ["PHSubtitle"] = $"{Model.GetFullName()} · Yeni şifre belirleyin"
})

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger d-flex align-items-start gap-2 mb-3" style="max-width:480px">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1"></i>
        <div>
            @foreach (var val in ViewData.ModelState.Values)
            {
                @foreach (var err in val.Errors)
                {
                    <div>@err.ErrorMessage</div>
                }
            }
        </div>
    </div>
}

<form method="post" asp-action="ResetPassword">
    @Html.AntiForgeryToken()
    <input type="hidden" name="studentId" value="@Model.StudentId" />
    <div class="form-card" style="max-width:480px">
        <div class="form-card-body">
            <div class="mb-3">
                <label class="form-label required">Yeni Şifre</label>
                <input type="password" name="newPassword"
                       class="form-control" minlength="6" required autofocus />
                <div class="form-text">En az 6 karakter.</div>
            </div>
            <div class="mb-0">
                <label class="form-label required">Şifre Tekrar</label>
                <input type="password" name="confirmPassword"
                       class="form-control" minlength="6" required />
            </div>
        </div>
        <div class="form-card-footer">
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-key me-1"></i>Şifreyi Sıfırla
            </button>
        </div>
    </div>
</form>
