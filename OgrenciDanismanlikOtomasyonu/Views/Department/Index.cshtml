@{
    ViewData["Title"] = "Ana Sayfa";
    var semester = ViewBag.CurrentSemester as EntityLayer.clsSemester;
}

@await Html.PartialAsync("_ProfileCard", ViewBag.ManagerProfile as EntityLayer.clsProfileCardInfo)

<div class="dashboard-info-card">
    <div class="dashboard-info-card-header">
        <div class="dashboard-info-card-icon">
            <i class="bi bi-calendar3"></i>
        </div>
        <div class="dashboard-info-card-title">Aktif Dönem</div>
    </div>

    @if (semester != null)
    {
        int daysLeft  = (semester.EndDate.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days;
        double totalDays = (semester.EndDate.ToDateTime(TimeOnly.MinValue) - semester.StartDate.ToDateTime(TimeOnly.MinValue)).TotalDays;
        double elapsed   = (DateTime.Today - semester.StartDate.ToDateTime(TimeOnly.MinValue)).TotalDays;
        int progressPct  = totalDays > 0
            ? (int)Math.Min(100, Math.Max(0, Math.Round(elapsed / totalDays * 100)))
            : 0;

        <table class="profile-card-table">
            <tbody>
                <tr>
                    <td class="profile-card-label">Dönem</td>
                    <td class="profile-card-value">@semester.AcademicYear @semester.Term</td>
                </tr>
                <tr>
                    <td class="profile-card-label">Başlangıç</td>
                    <td class="profile-card-value">@semester.StartDate.ToString("dd.MM.yyyy")</td>
                </tr>
                <tr>
                    <td class="profile-card-label">Bitiş</td>
                    <td class="profile-card-value">@semester.EndDate.ToString("dd.MM.yyyy")</td>
                </tr>
                <tr>
                    <td class="profile-card-label">Kalan Gün</td>
                    <td class="profile-card-value">
                        @if (daysLeft > 0)
                        {
                            <span>@daysLeft gün</span>
                        }
                        else if (daysLeft == 0)
                        {
                            <span>Bugün sona eriyor</span>
                        }
                        else
                        {
                            <span class="text-muted">Dönem sona erdi</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>

        <div class="semester-progress-wrap">
            <div class="progress semester-progress-bar">
                <div class="progress-bar bg-primary" role="progressbar"
                     style="width: @progressPct%"
                     aria-valuenow="@progressPct" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <div class="semester-progress-labels">
                <span>@semester.StartDate.ToString("dd.MM.yyyy")</span>
                <span>@progressPct% tamamlandı</span>
                <span>@semester.EndDate.ToString("dd.MM.yyyy")</span>
            </div>
        </div>
    }
    else
    {
        <div class="dashboard-info-card-body">
            <span class="text-muted">Aktif dönem yok.</span>
        </div>
    }
</div>
