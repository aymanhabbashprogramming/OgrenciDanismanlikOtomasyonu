@model BusinessLogicLayer.clsFacultyBusiness
@{
    bool isNew = Model.FacultyId == -1;
    ViewData["Title"] = isNew ? "Yeni Fakülte" : "Fakülte Düzenle";
}

<h2>@ViewData["Title"]</h2>

<div class="row mt-3">
    <div class="col-md-6">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var val in ViewData.ModelState.Values)
                {
                    @foreach (var err in val.Errors)
                    {
                        <div>@err.ErrorMessage</div>
                    }
                }
            </div>
        }

        <form method="post" asp-action="Edit">
            @Html.AntiForgeryToken()
            <input type="hidden" name="facultyId" value="@Model.FacultyId" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Fakülte Adı</label>
                <input type="text" name="facultyName" value="@Model.FacultyName"
                       class="form-control" maxlength="200" required />
            </div>

            <button type="submit" class="btn btn-primary me-2">Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </form>
    </div>
</div>
