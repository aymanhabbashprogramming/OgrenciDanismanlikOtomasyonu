@model BusinessLogicLayer.clsFacultyBusiness
@{
    bool isNew = Model.FacultyId == -1;
    ViewData["Title"] = isNew ? "Yeni Fakülte" : "Fakülte Düzenle";
}

@await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData) {
    ["HeaderTitle"]    = isNew ? "Yeni Fakülte" : "Fakülte Düzenle",
    ["HeaderSubtitle"] = isNew ? "Yeni bir fakülte kaydı ekleyin" : "Fakülte bilgilerini güncelleyin"
})

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger d-flex align-items-start gap-2 mb-3" style="max-width:640px">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1"></i>
        <div>
            @foreach (var fieldState in ViewData.ModelState.Values)
            {
                @foreach (var fieldError in fieldState.Errors)
                {
                    <div>@fieldError.ErrorMessage</div>
                }
            }
        </div>
    </div>
}

<form method="post" asp-action="Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="facultyId" value="@Model.FacultyId" />
    <div class="form-card">
        <div class="form-card-body">
            <div class="mb-0">
                <label class="form-label required">Fakülte Adı</label>
                <input type="text" name="facultyName" value="@Model.FacultyName"
                       class="form-control" maxlength="200" required autofocus />
            </div>
        </div>
        <div class="form-card-footer">
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2 me-1"></i>Kaydet
            </button>
        </div>
    </div>
</form>
