@model List<EntityLayer.clsStudentInfo>
@{
    ViewData["Title"] = "Öğrencilerim";
    int studentCount = ViewBag.StudentCount ?? 0;
}

@await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData) {
    ["HeaderTitle"]    = "Öğrencilerim",
    ["HeaderSubtitle"] = "Size atanmış öğrenci listesi"
})

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        @await Html.PartialAsync("_CurrentSemester", new ViewDataDictionary(ViewData) {
            ["CurrentSemester"] = ViewBag.CurrentSemester as EntityLayer.clsSemester
        })
    </div>
    <div class="col-sm-6 col-lg-3">
        @await Html.PartialAsync("_StatCard", new ViewDataDictionary(ViewData) {
            ["CardIcon"]  = "bi-mortarboard",
            ["CardCount"] = studentCount,
            ["CardLabel"] = "Öğrencilerim",
            ["CardLink"]  = Url.Action("Index", "Advisor")
        })
    </div>
</div>

@if (!Model.Any())
{
    @await Html.PartialAsync("_EmptyState", new ViewDataDictionary(ViewData) {
        ["EmptyIcon"]    = "bi-mortarboard",
        ["EmptyMessage"] = "Henüz size atanmış öğrenci bulunmamaktadır."
    })
}
else
{
    <div class="card-table">
        <table class="table data-table mb-0">
            <thead>
                <tr>
                    <th>Öğrenci No</th>
                    <th>Ad Soyad</th>
                    <th>Bölüm</th>
                    <th>Öğretim Türü</th>
                    <th>Sınıf</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-id" data-label="Öğrenci No">@item.StudentNumber</td>
                        <td data-label="Ad Soyad">@item.FullName</td>
                        <td data-label="Bölüm">@item.DepartmentName</td>
                        <td data-label="Öğretim Türü">@item.EducationType</td>
                        <td data-label="Sınıf">@(item.ClassYear.HasValue ? item.ClassYear + ". Sınıf" : "—")</td>
                        <td data-label="Durum">
                            @if (item.IsActive)
                            {
                                <span class="status-accepted">Aktif</span>
                            }
                            else
                            {
                                <span class="status-sent">Pasif</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
