@model EntityLayer.clsSurveyResultInfo
@{
    ViewData["Title"] = "Anket Sonuçları";
    var survey            = Model.Survey;
    int participationCount = survey.ParticipationCount;
    int aktifCount         = Model.AktifStudentCount;
    double rate            = aktifCount > 0 ? Math.Round((double)participationCount / aktifCount * 100, 1) : 0;
}

@functions {
    static string ScoreColor(double score)
    {
        if (score <= 3) return "var(--score-low)";
        if (score <= 6) return "var(--score-medium)";
        if (score <= 8) return "var(--score-good)";
        return "var(--score-excellent)";
    }
}

@await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData) {
    ["HeaderTitle"]    = survey.Title,
    ["HeaderSubtitle"] = $"Anket sonuçları — {survey.SemesterName}"
})

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        @await Html.PartialAsync("_StatCard", new ViewDataDictionary(ViewData) {
            ["CardIcon"]  = "bi-people",
            ["CardLabel"] = $"Katılım ({aktifCount} Aktif'ten)",
            ["CardCount"] = participationCount.ToString(),
            ["CardLink"]  = "#"
        })
    </div>
    <div class="col-6 col-md-3">
        @await Html.PartialAsync("_StatCard", new ViewDataDictionary(ViewData) {
            ["CardIcon"]  = "bi-percent",
            ["CardLabel"] = "Katılım Oranı",
            ["CardCount"] = $"%{rate}",
            ["CardLink"]  = "#"
        })
    </div>
    <div class="col-6 col-md-3">
        @await Html.PartialAsync("_StatCard", new ViewDataDictionary(ViewData) {
            ["CardIcon"]  = "bi-question-circle",
            ["CardLabel"] = "Soru Sayısı",
            ["CardCount"] = Model.QuestionResults.Count.ToString(),
            ["CardLink"]  = "#"
        })
    </div>
</div>

@if (participationCount == 0)
{
    <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-info-circle flex-shrink-0"></i>
        <span>Henüz kimse bu ankete katılmadı.</span>
    </div>
}

@foreach (var questionResult in Model.QuestionResults)
{
    <div class="form-card mb-3" style="max-width:720px">
        <div class="form-card-body">
            <div class="d-flex align-items-start gap-2 mb-3">
                <span class="badge @(questionResult.QuestionType == "Puanlama" ? "bg-primary" : "bg-secondary") flex-shrink-0 mt-1">
                    @(questionResult.QuestionType == "Puanlama" ? "Puanlama" : "Serbest Metin")
                </span>
                <strong>@questionResult.QuestionText</strong>
            </div>

            <div class="text-muted small mb-3">@questionResult.AnswerCount yanıt</div>

            @if (questionResult.QuestionType == "Puanlama")
            {
                if (questionResult.AnswerCount > 0)
                {
                    string avgColor = ScoreColor(questionResult.AverageScore ?? 0);
                    double avgPct   = (questionResult.AverageScore ?? 0) * 10;
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="score-bar-track" style="max-width:280px;flex:1;height:10px">
                            <div class="score-bar-fill"
                                 style="width:@avgPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;background-color:@avgColor"></div>
                        </div>
                        <span class="fs-5 fw-bold" style="color:@avgColor">
                            @questionResult.AverageScore?.ToString("0.0")
                            <span class="text-muted fw-normal fs-6"> / 10</span>
                        </span>
                    </div>
                    <div class="mb-1">
                        @for (int scoreIndex = 9; scoreIndex >= 0; scoreIndex--)
                        {
                            int    count      = questionResult.ScoreDistribution[scoreIndex];
                            int    scoreValue = scoreIndex + 1;
                            string barColor   = ScoreColor(scoreValue);
                            double percent    = questionResult.AnswerCount > 0
                                               ? Math.Round((double)count / questionResult.AnswerCount * 100, 0)
                                               : 0;
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="text-muted" style="width:16px;text-align:right;font-size:.85rem">@scoreValue</span>
                                <div class="score-bar-track" style="flex:1">
                                    <div class="score-bar-fill"
                                         style="width:@percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;background-color:@barColor"></div>
                                </div>
                                <span class="text-muted small" style="width:36px">@count</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted">Yanıt yok.</span>
                }
            }
            else
            {
                if (questionResult.FreeTextAnswers.Any())
                {
                    <ul class="mb-0 ps-3">
                        @foreach (var answer in questionResult.FreeTextAnswers)
                        {
                            <li class="mb-1">@answer</li>
                        }
                    </ul>
                }
                else
                {
                    <span class="text-muted">Metin yanıt yok.</span>
                }
            }
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Listeye Dön
    </a>
</div>
