@{
    var title      = ViewData["HeaderTitle"]      as string ?? "";
    var subtitle   = ViewData["HeaderSubtitle"]   as string ?? "";
    var actionText = ViewData["HeaderActionText"] as string ?? "";
    var actionLink = ViewData["HeaderActionLink"] as string ?? "#";
}
<div class="page-header">
    <div>
        <h1 class="page-header-title">@title</h1>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <p class="page-header-subtitle">@subtitle</p>
        }
    </div>
    @if (!string.IsNullOrEmpty(actionText))
    {
        <a href="@actionLink" class="btn btn-primary flex-shrink-0">
            <i class="bi bi-plus-lg me-1"></i>@actionText
        </a>
    }
</div>
