<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Öğrenci Danışmanlık</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OgrenciDanismanlikOtomasyonu.styles.css" asp-append-version="true" />
</head>
<body class="student-layout-body">
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string NavActive(string controller) =>
        currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    var firstName = User.FindFirstValue(System.Security.Claims.ClaimTypes.GivenName)
                    ?? User.Identity?.Name ?? "";
}

<!-- ── Top navigation bar ──────────────────────────────────── -->
<nav class="student-navbar">
    <div class="student-navbar-inner">

        <!-- Left: logo + brand -->
        <a class="student-navbar-brand" asp-controller="Student" asp-action="Index">
            <i class="bi bi-mortarboard-fill"></i>
            <span>ÖDO</span>
        </a>

        <!-- Middle: navigation links -->
        <div class="student-navbar-links" id="studentNavLinks">
            <a class="student-nav-link @NavActive("Student")"
               asp-controller="Student" asp-action="Index">Ana Sayfa</a>
            <a class="student-nav-link" href="#">Bilgilerim</a>
            <a class="student-nav-link" href="#">Danışmanım</a>
            <a class="student-nav-link" href="#">Taleplerim</a>
            <a class="student-nav-link @NavActive("StudentSurveys")"
               asp-controller="StudentSurveys" asp-action="Index">Anketler</a>
        </div>

        <!-- Right: first name + logout -->
        <div class="student-navbar-right">
            <span class="student-navbar-username">@firstName</span>
            <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                <button type="submit" class="btn-student-logout">
                    <i class="bi bi-box-arrow-right me-1"></i>Çıkış
                </button>
            </form>
        </div>

        <!-- Mobile hamburger -->
        <button class="student-navbar-toggler" id="studentNavToggle" aria-label="Menüyü aç/kapat">
            <i class="bi bi-list"></i>
        </button>

    </div>
</nav>

<!-- ── Main content ────────────────────────────────────────── -->
<main class="student-main">
    <div class="student-content-column">
        @RenderBody()
    </div>
</main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/l10n/tr.min.js"></script>
<script>
    document.querySelectorAll('.datepicker').forEach(function (input) {
        flatpickr(input, {
            locale: 'tr',
            dateFormat: 'Y-m-d',
            altInput: true,
            altFormat: 'd.m.Y',
            allowInput: true
        });
    });
</script>
<script>
    (function () {
        var toggle   = document.getElementById('studentNavToggle');
        var navLinks = document.getElementById('studentNavLinks');

        if (toggle && navLinks)
        {
            toggle.addEventListener('click', function () {
                navLinks.classList.toggle('show');
            });
        }

        // Close menu when a link is clicked on mobile
        document.querySelectorAll('.student-nav-link').forEach(function (link) {
            link.addEventListener('click', function () {
                if (navLinks) navLinks.classList.remove('show');
            });
        });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
