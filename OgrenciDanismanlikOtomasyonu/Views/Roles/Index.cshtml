@model List<EntityLayer.clsRole>
@{
    ViewData["Title"] = "Roller";
}

@await Html.PartialAsync("_PageHeader", new ViewDataDictionary(ViewData) {
    ["PHTitle"]    = "Roller",
    ["PHSubtitle"] = "Sistemde tanımlı roller"
})

@if (!Model.Any())
{
    @await Html.PartialAsync("_EmptyState", new ViewDataDictionary(ViewData) {
        ["ESIcon"]    = "bi-shield-slash",
        ["ESMessage"] = "Kayıtlı rol bulunamadı."
    })
}
else
{
    <div class="card-table">
        <table class="table data-table mb-0">
            <thead>
                <tr>
                    <th style="width:70px">No</th>
                    <th>Rol Adı</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td class="text-id">@role.RoleId</td>
                        <td>@role.RoleName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
