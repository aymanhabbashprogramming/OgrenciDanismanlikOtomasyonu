@model EntityLayer.clsRequestFormPreFillInfo
@{
    ViewData["Title"] = "TF-ÖİŞL-02 Ders Ekleme/Çıkarma";
}

<div class="student-page-heading">
    <h1>TF-ÖİŞL-02 — Ders Ekleme/Çıkarma</h1>
</div>

<partial name="_RequestStudentHeader" model="Model" />

<form method="post" asp-controller="StudentRequests" asp-action="Submit02">
    @Html.AntiForgeryToken()
    <input type="hidden" name="formCode" value="TF-ÖİŞL-02" />

    <div class="student-card mb-3">
        <div class="student-card-header">
            <span><i class="bi bi-chat-left-text me-2"></i>Gerekçe</span>
        </div>
        <div class="student-card-body">
            <textarea name="reason" class="form-control" rows="3" required
                      placeholder="Ders ekleme veya çıkarma gerekçenizi yazınız..."></textarea>
        </div>
    </div>

    <div class="student-card mb-3">
        <div class="student-card-header">
            <span><i class="bi bi-table me-2"></i>Dersler</span>
            <button type="button" class="btn-student-add-row" id="addRow02">
                <i class="bi bi-plus-lg me-1"></i>Ders Ekle
            </button>
        </div>
        <div class="student-card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0" id="courseTable02">
                    <thead>
                        <tr>
                            <th>Ders Kodu</th>
                            <th>Ders Adı</th>
                            <th>Devam Durumu</th>
                            <th>İşlem</th>
                            <th class="cell-actions"></th>
                        </tr>
                    </thead>
                    <tbody id="courseRows02">
                        <tr class="course-row">
                            <td data-label="Ders Kodu">
                                <input type="text" name="courseCode" class="form-control form-control-sm" placeholder="BLM301" required />
                            </td>
                            <td data-label="Ders Adı">
                                <input type="text" name="courseName" class="form-control form-control-sm" placeholder="Veri Yapıları" required />
                            </td>
                            <td data-label="Devam Durumu">
                                <select name="attendanceStatus" class="form-select form-select-sm">
                                    <option value="İLK">İLK</option>
                                    <option value="DVLT">DVLT</option>
                                    <option value="DVST">DVST</option>
                                </select>
                            </td>
                            <td data-label="İşlem">
                                <select name="operation" class="form-select form-select-sm">
                                    <option value="Ekleme">Ekleme</option>
                                    <option value="Çıkarma">Çıkarma</option>
                                </select>
                            </td>
                            <td data-label="" class="cell-actions">
                                <button type="button" class="btn btn-sm btn-outline-danger remove-row"
                                        title="Satırı sil">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="student-card mb-3">
        <div class="student-card-body">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="declarationAccepted"
                       value="true" id="declaration02" required />
                <label class="form-check-label" for="declaration02">
                    Yukarıda belirtilen gerekçe doğrultusunda, aşağıdaki çizelgede belirtilen derslere ilişkin talebimin değerlendirilerek gereğinin yapılmasını arz ederim.
                </label>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn-student-submit">
            <i class="bi bi-send"></i>Gönder
        </button>
        <a asp-controller="StudentRequests" asp-action="New"
           class="btn-student-cancel">İptal</a>
    </div>
</form>

@section Scripts {
<script>
(function () {
    var tbody   = document.getElementById('courseRows02');
    var addBtn  = document.getElementById('addRow02');

    addBtn.addEventListener('click', function () {
        var firstRow = tbody.querySelector('.course-row');
        var newRow   = firstRow.cloneNode(true);
        newRow.querySelectorAll('input').forEach(function (input) { input.value = ''; });
        tbody.appendChild(newRow);
        _bindRemove(newRow);
    });

    tbody.querySelectorAll('.course-row').forEach(_bindRemove);

    function _bindRemove(row) {
        row.querySelector('.remove-row')?.addEventListener('click', function () {
            if (tbody.querySelectorAll('.course-row').length > 1) {
                row.remove();
            }
        });
    }
})();
</script>
}
