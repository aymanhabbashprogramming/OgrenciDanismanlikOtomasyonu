@model EntityLayer.clsRequestFormPreFillInfo
@{
    ViewData["Title"] = "TF-ÖİŞL-05 Not Yükseltme";
}

<div class="student-page-heading">
    <h1>TF-ÖİŞL-05 — Not Yükseltme</h1>
</div>

<partial name="_RequestStudentHeader" model="Model" />

<form method="post" asp-controller="StudentRequests" asp-action="Submit05">
    @Html.AntiForgeryToken()
    <input type="hidden" name="formCode" value="TF-ÖİŞL-05" />

    <div class="student-card mb-3">
        <div class="student-card-header">
            <span><i class="bi bi-table me-2"></i>Dersler</span>
            <button type="button" class="btn-student-add-row" id="addRow05">
                <i class="bi bi-plus-lg me-1"></i>Ders Ekle
            </button>
        </div>
        <div class="student-card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Ders Kodu</th>
                            <th>Ders Adı</th>
                            <th>Önceki Not / Harf</th>
                            <th class="cell-actions"></th>
                        </tr>
                    </thead>
                    <tbody id="courseRows05">
                        <tr class="course-row">
                            <td data-label="Ders Kodu">
                                <input type="text" name="courseCode" class="form-control form-control-sm" placeholder="BLM301" required />
                            </td>
                            <td data-label="Ders Adı">
                                <input type="text" name="courseName" class="form-control form-control-sm" placeholder="Veri Yapıları" required />
                            </td>
                            <td data-label="Önceki Not / Harf">
                                <input type="text" name="previousGrade" class="form-control form-control-sm"
                                       placeholder="75 / CB" />
                            </td>
                            <td data-label="" class="cell-actions">
                                <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="Satırı sil">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="student-card mb-3">
        <div class="student-card-body">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="declarationAccepted"
                       value="true" id="declaration05" required />
                <label class="form-check-label" for="declaration05">
                    Daha önceden alıp geçtiğim halde notum BB'nin altında olduğu için not yükseltmek amacıyla yukarıdaki ders(ler)i tekrar almak istiyorum. Önceki notumdan daha düşük not alsam bile yönetmelik gereği son alınan notun geçerli olduğunu biliyorum. Gereğini saygılarımla arz ederim.
                </label>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn-student-submit">
            <i class="bi bi-send"></i>Gönder
        </button>
        <a asp-controller="StudentRequests" asp-action="New"
           class="btn-student-cancel">İptal</a>
    </div>
</form>

@section Scripts {
<script>
(function () {
    var tbody  = document.getElementById('courseRows05');
    var addBtn = document.getElementById('addRow05');

    addBtn.addEventListener('click', function () {
        var newRow = tbody.querySelector('.course-row').cloneNode(true);
        newRow.querySelectorAll('input').forEach(function (input) { input.value = ''; });
        tbody.appendChild(newRow);
        _bindRemove(newRow);
    });

    tbody.querySelectorAll('.course-row').forEach(_bindRemove);

    function _bindRemove(row) {
        row.querySelector('.remove-row')?.addEventListener('click', function () {
            if (tbody.querySelectorAll('.course-row').length > 1) row.remove();
        });
    }
})();
</script>
}
